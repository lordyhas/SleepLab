<?xml version="1.0" encoding="utf-8"?>
<!-- Snore audio clips are private recordings: never back them up or transfer them. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="clips/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="clips/" />
    </device-transfer>
</data-extraction-rules>
